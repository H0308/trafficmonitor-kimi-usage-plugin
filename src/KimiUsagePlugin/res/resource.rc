#pragma code_page(65001)

#include "resource.h"
#include <windows.h>

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDD_OPTIONS_DIALOG DIALOGEX 0, 0, 280, 160
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Kimi Code 限额插件设置"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "API Key:", IDC_STATIC_API_KEY, 10, 10, 50, 12
    EDITTEXT        IDC_EDIT_API_KEY, 65, 8, 205, 14, ES_AUTOHSCROLL

    LTEXT           "刷新间隔(秒):", IDC_STATIC_INTERVAL, 10, 35, 60, 12
    EDITTEXT        IDC_EDIT_INTERVAL, 75, 33, 50, 14, ES_NUMBER

    LTEXT           "低限额阈值(%):", IDC_STATIC_THRESHOLD, 140, 35, 70, 12
    EDITTEXT        IDC_EDIT_THRESHOLD, 215, 33, 50, 14, ES_NUMBER

    CONTROL         "显示5小时重置倒计时", IDC_CHECK_SHOW_5H_RESET, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 60, 120, 12
    CONTROL         "显示7天重置倒计时", IDC_CHECK_SHOW_7D_RESET, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 140, 60, 120, 12

    DEFPUSHBUTTON   "确定", IDOK, 115, 135, 50, 16
    PUSHBUTTON      "取消", IDCANCEL, 175, 135, 50, 16
END
